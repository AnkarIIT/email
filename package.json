{
  "name": "mailkey",
  "version": "0.1.0",
  "description": "Embeddable OTP + transactional email library for Node.js. SMTP, Resend and console transports, Handlebars templates, hashed OTP storage with attempt limits and cooldowns.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx demo.ts"
  },
  "keywords": [
    "email",
    "otp",
    "smtp",
    "resend",
    "nodemailer",
    "transactional",
    "verification-code",
    "handlebars"
  ],
  "license": "MIT",
  "dependencies": {
    "handlebars": "^4.7.8",
    "nodemailer": "^10.3.1"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
