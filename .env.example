# ── Transport ────────────────────────────────────────────────
# One of: resend | smtp | console
# console = dev mode: prints the email to the terminal instead of sending.
#          Perfect for local testing with zero credentials.
EMAIL_TRANSPORT=resend

# Resend (https://resend.com — free tier: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (if EMAIL_TRANSPORT=smtp)
# Dev/testing: your Gmail + App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_SECURE=false

# ── Identity ─────────────────────────────────────────────────
# Must match a domain you verify with your provider.
EMAIL_FROM="MyApp <no-reply@myapp.com>"
APP_NAME=MyApp

# ── OTP security ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=change-me-to-a-long-random-secret
